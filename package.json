{
  "name": "it-dev-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Internal equipment checks control panel",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && node build.mjs",
    "start": "npm run build && node --env-file-if-exists=.env dist/server.js",
    "serve": "node --env-file-if-exists=.env dist/server.js",
    "test": "npm run build && node --test test/*.test.cjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json"
  },
  "dependencies": {
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "axios": "^1.13.0",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.0.0",
    "ping": "^0.4.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "overrides": { "multer": "^2.5.0", "@azure/msal-node": "^7.1.1" },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/mssql": "^9.1.0",
    "@types/node": "^24.0.0",
    "@types/ping": "^0.4.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
